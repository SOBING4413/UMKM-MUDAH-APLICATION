<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <TextView android:id="@+id/tv_nama_barang"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nama Barang"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/on_surface"/>

            <TextView android:id="@+id/tv_kategori"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Kategori"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="8dp" android:paddingVertical="3dp"
                android:textSize="11sp" android:textColor="@color/primary"/>
        </LinearLayout>

        <!-- Harga + Stok -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:id="@+id/tv_harga_jual"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jual: Rp 0"
                android:textSize="13sp" android:textColor="@color/accent" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_stok"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Stok: 0 pcs"
                android:textSize="13sp" android:textColor="@color/on_surface_variant"/>
        </LinearLayout>

        <!-- Aksi stok -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_kurang_stok"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="− 1"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/expense"
                android:strokeColor="@color/expense"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tambah_stok"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="+ 10"
                android:textSize="13sp"
                android:backgroundTint="@color/accent"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <!-- Avatar circle -->
            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="👤"
                android:textSize="18sp"
                android:layout_marginEnd="12dp"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_nama_pelanggan"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nama Pelanggan"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/on_surface"/>
                <TextView android:id="@+id/tv_telepon"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0812xxxxxxx"
                    android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hapus_pelanggan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑"
                android:textSize="16sp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/expense"/>
        </LinearLayout>

        <!-- Stats row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp"
            android:background="@color/surface_variant"
            android:padding="8dp">
            <TextView android:id="@+id/tv_total_belanja"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: Rp 0"
                android:textSize="12sp" android:textColor="@color/income" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_jml_transaksi"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 transaksi"
                android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
